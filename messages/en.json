{
  "pages": {
    "bajameister": {
      "title": "Bajameister",
      "subtitle": "Where Engineering Meets the Party",
      "intro": "BajaETS teams up with Jagermeister and Red Bull for an unforgettable night where off-road engineering meets epic celebrations.",
      "description": "Experience the fusion of adrenaline and innovation as we showcase our student-built Baja off-road vehicle in a one-of-a-kind party atmosphere. Witness the machine that conquers any terrain while enjoying the ultimate party experience.",
      "partners-title": "Powered By",
      "event-highlight": "One Night. Two Legends. Unlimited Energy.",
      "cta": "Join the Experience",
      "event-date": "February 27th, 2026",
      "event-time": "8 PM - 3 AM",
      "event-location": "530 Peel Street, Montreal, QC",
      "event-details-title": "Event Details"
    },
    "home": {
      "title": "Home",
      "content": {
        "who-we-are": {
          "title": "Who we are",
          "text": "BajaETS is a student team from École de Technologie Supérieure (ETS) in Montreal, Canada that competes in the Baja SAE competition. The team is comprised of students from various engineering disciplines who come together to design, build, and race an off-road vehicle against other universities from around the world. BajaETS has been participating in the competition since 1989 and has consistently placed well, including several top 10 finishes. The team prides itself on its innovative designs, strong teamwork, and dedication to pushing the limits of off-road racing technology."
        },
        "research-and-innovation": {
          "title": "Research and Innovation",
          "text": "At BajaETS, integrating technology is a top priority. In the 2017 season, we made history as the first team to win using an electronically actuated continuously variable transmission (EVT) that we developed ourselves. This innovation was a game-changer, now patented to B-Cinq Technologies, a company funded by BajaETS alumni. We're proud of our achievement and excited for the future of this technology."
        }
      }
    },
